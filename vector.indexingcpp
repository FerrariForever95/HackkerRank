#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    vector <int> v;
    int n;
    int query;
    cin>>n;
    for(int i=0;i<n;i++){
        int x;
        cin>>x;
        v.push_back(x);
        
    }  
    cin>>query;
    
    for (int i = 0; i < query; i++) {

        int value;
        cin >> value;

        vector<int>::iterator it =
            lower_bound(v.begin(), v.end(), value);

        if (*it == value) {
            cout << "Yes " << (it - v.begin() + 1) << "\n";
        }
        else {
            cout << "No " << (it - v.begin() + 1) << "\n";
        }
    }

    return 0;
}
